<Project Sdk="Microsoft.NET.Sdk">

  <!-- The model of WasmOS: pure, no host.  It runs under .NET (Tests/) and is compiled to WebAssembly GC with the browser project that references it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <AssemblyName>WasmOs.Core</AssemblyName>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Model.fs" />
  </ItemGroup>

</Project>
